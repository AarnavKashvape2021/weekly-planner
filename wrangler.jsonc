{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "weekly-study-planner",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-18",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "weekly-planner-db",
      "database_id": "PASTE_YOUR_D1_DATABASE_ID_HERE"
    }
  ]
}
